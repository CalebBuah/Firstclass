<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/logo"
        android:layout_width="match_parent"
        android:layout_height="37dp"
        android:text="Calculator"
        android:textAlignment="viewStart"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="-3dp" />

    <TextView
        android:id="@+id/screen"
        android:layout_width="match_parent"
        android:layout_height="153dp"
        android:layout_marginTop="4dp"
        android:text="Standard"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/logo"
        tools:layout_editor_absoluteX="-16dp" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/answer"
        android:layout_width="136dp"
        android:layout_height="67dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/screen"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/value"
            android:layout_width="91dp"
            android:layout_height="51dp"
            android:text="0"
            android:textAlignment="viewEnd"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/textView17"
        android:layout_width="90dp"
        android:layout_height="37dp"
        android:text="-"
        android:textAlignment="center"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/navicon1"
        app:layout_constraintTop_toTopOf="@+id/logo" />

    <TextView
        android:id="@+id/navicon1"
        android:layout_width="73dp"
        android:layout_height="39dp"
        android:text="X"
        android:textAlignment="center"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/logo"
        app:layout_constraintTop_toTopOf="@+id/logo" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="76dp"
        android:layout_height="30dp"
        android:text="MC"
        android:textAlignment="center"
        android:textColor="#A61818"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/screen" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="67dp"
        android:layout_height="31dp"
        android:text="MR"
        android:textAlignment="center"
        app:layout_constraintStart_toEndOf="@+id/textView"
        app:layout_constraintTop_toBottomOf="@+id/screen" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="55dp"
        android:layout_height="24dp"
        android:layout_marginTop="4dp"
        android:text="MS"
        android:textAlignment="center"
        android:textColor="#A61818"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/screen" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="55dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:text="M+"
        android:textAlignment="center"
        android:textColor="#A61818"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@+id/textView2"
        app:layout_constraintTop_toBottomOf="@+id/screen" />

    <TextView
        android:id="@+id/textView6"
        android:layout_width="68dp"
        android:layout_height="28dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:text="MS"
        android:textAlignment="center"
        android:textColor="#A61818"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/textView3"
        app:layout_constraintTop_toBottomOf="@+id/screen" />

    <TextView
        android:id="@+id/textView7"
        android:layout_width="80dp"
        android:layout_height="32dp"
        android:text="M-"
        android:textAlignment="center"
        android:textColor="#A61818"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/textView6"
        app:layout_constraintStart_toEndOf="@+id/textView5"
        app:layout_constraintTop_toBottomOf="@+id/screen" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="338dp"
        app:layout_constraintTop_toBottomOf="@+id/textView5"
        tools:layout_editor_absoluteX="0dp">

        <Button
            android:id="@+id/button36"
            android:layout_width="96dp"
            android:layout_height="50dp"
            android:text="."
            app:layout_constraintStart_toEndOf="@+id/button35"
            app:layout_constraintTop_toBottomOf="@+id/button29" />

        <Button
            android:id="@+id/button37"
            android:layout_width="95dp"
            android:layout_height="50dp"
            android:backgroundTint="#FF5722"
            android:text="="
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/button30" />

        <Button
            android:id="@+id/button35"
            android:layout_width="110dp"
            android:layout_height="51dp"
            android:text="0"
            app:layout_constraintStart_toEndOf="@+id/button33"
            app:layout_constraintTop_toBottomOf="@+id/button28" />

        <Button
            android:id="@+id/button30"
            android:layout_width="96dp"
            android:layout_height="55dp"
            android:backgroundTint="@color/black"
            android:text="+"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/button27" />

        <Button
            android:id="@+id/button29"
            android:layout_width="97dp"
            android:layout_height="54dp"
            android:text="3"
            app:layout_constraintStart_toEndOf="@+id/button28"
            app:layout_constraintTop_toBottomOf="@+id/button24" />

        <Button
            android:id="@+id/button28"
            android:layout_width="107dp"
            android:layout_height="51dp"
            android:text="2"
            app:layout_constraintStart_toEndOf="@+id/button26"
            app:layout_constraintTop_toBottomOf="@+id/button23" />

        <Button
            android:id="@+id/button27"
            android:layout_width="98dp"
            android:layout_height="49dp"
            android:backgroundTint="@color/black"
            android:text="-"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/button21" />

        <Button
            android:id="@+id/button26"
            android:layout_width="110dp"
            android:layout_height="51dp"
            android:text="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/button22" />

        <Button
            android:id="@+id/button24"
            android:layout_width="100dp"
            android:layout_height="50dp"
            android:text="6"
            app:layout_constraintStart_toEndOf="@+id/button23"
            app:layout_constraintTop_toBottomOf="@+id/button20" />

        <Button
            android:id="@+id/button22"
            android:layout_width="110dp"
            android:layout_height="51dp"
            android:text="4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/button15" />

        <Button
            android:id="@+id/button23"
            android:layout_width="103dp"
            android:layout_height="51dp"
            android:text="5"
            app:layout_constraintStart_toEndOf="@+id/button22"
            app:layout_constraintTop_toBottomOf="@+id/button19" />

        <Button
            android:id="@+id/button21"
            android:layout_width="97dp"
            android:layout_height="56dp"
            android:backgroundTint="@color/black"
            android:text="*"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/button14" />

        <Button
            android:id="@+id/button20"
            android:layout_width="99dp"
            android:layout_height="54dp"
            android:text="9"
            app:layout_constraintStart_toEndOf="@+id/button19"
            app:layout_constraintTop_toBottomOf="@+id/button13" />

        <Button
            android:id="@+id/button12"
            android:layout_width="110dp"
            android:layout_height="51dp"
            android:text="x2"
            app:layout_constraintStart_toEndOf="@+id/button11"
            app:layout_constraintTop_toBottomOf="@+id/button8" />

        <Button
            android:id="@+id/button13"
            android:layout_width="89dp"
            android:layout_height="48dp"
            android:text="2√x"
            app:layout_constraintStart_toEndOf="@+id/button12"
            app:layout_constraintTop_toBottomOf="@+id/button9" />

        <Button
            android:id="@+id/button14"
            android:layout_width="103dp"
            android:layout_height="49dp"
            android:backgroundTint="@color/black"
            android:text="÷"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageButton" />

        <Button
            android:id="@+id/button9"
            android:layout_width="110dp"
            android:layout_height="51dp"
            android:text="C"
            android:textAlignment="center"
            app:layout_constraintStart_toEndOf="@+id/button8"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/imageButton"
            android:layout_width="82dp"
            android:layout_height="49dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@android:drawable/ic_input_delete" />

        <Button
            android:id="@+id/button7"
            android:layout_width="110dp"
            android:layout_height="51dp"
            android:text="%"
            android:textAlignment="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/button8"
            android:layout_width="110dp"
            android:layout_height="51dp"
            android:text="CE"
            android:textAlignment="center"
            app:layout_constraintStart_toEndOf="@+id/button7"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/button11"
            android:layout_width="110dp"
            android:layout_height="51dp"
            android:text="1/x"
            android:textAlignment="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/button7" />

        <Button
            android:id="@+id/button15"
            android:layout_width="103dp"
            android:layout_height="51dp"
            android:text="7"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/button11" />

        <Button
            android:id="@+id/button19"
            android:layout_width="110dp"
            android:layout_height="51dp"
            android:text="8"
            app:layout_constraintStart_toEndOf="@+id/button15"
            app:layout_constraintTop_toBottomOf="@+id/button12" />

        <Button
            android:id="@+id/button33"
            android:layout_width="110dp"
            android:layout_height="51dp"
            android:text="+/-"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/button26" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>